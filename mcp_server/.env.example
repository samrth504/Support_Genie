# Environment variables for the SupportGenie MCP server (mcp_server/server.py).
# The server reads them from the environment - set them in your MCP client's config
# (e.g. the "env" block of claude_desktop_config.json) or in your terminal before running.
# NEVER commit real values.

# Where the SupportGenie backend is running
SUPPORTGENIE_API_URL=http://localhost:8000

# A STAFF account (create one with: python -m scripts.create_staff --name "..." --email ...)
SUPPORTGENIE_EMAIL=staff@example.com
SUPPORTGENIE_PASSWORD=your-staff-password
