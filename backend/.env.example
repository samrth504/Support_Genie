# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env (it is in .gitignore).

# --- App ---
APP_NAME=SupportGenie API
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO

# --- Database (Neon -> Project -> Connection string) ---
# Paste it as-is; "postgresql://" is converted to the psycopg driver automatically.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Auth ---
# Long random string (min 32 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS (comma separated) ---
FRONTEND_URL=http://localhost:5173

# --- LLM providers (used from Module 4 onwards) ---
GROQ_API_KEY=
GOOGLE_API_KEY=
# Optional: override the Groq model (see https://console.groq.com/docs/models)
GROQ_MODEL=openai/gpt-oss-120b

# --- Security ---
RATE_LIMIT_ENABLED=true
# How many proxies YOU control sit in front of the app: 0 locally, 1 on Render
TRUSTED_PROXY_HOPS=0
