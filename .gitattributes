# Normalise line endings in the repo; Windows checkouts still get CRLF where Git is set up that way
* text=auto
*.ps1 text eol=crlf
*.sh  text eol=lf

# Binary files - never touch their bytes
*.png    binary
*.jpg    binary
*.joblib binary
*.pdf    binary

# Big CSVs: store as text but don't try to show line diffs
*.csv text -diff
